# Copy to .env for local nhost Functions (used by `nhost up`)
# Never commit the real .env — it's gitignored.

# Groq API (https://console.groq.com/keys) — used by the llm_call step
GROQ_API_KEY=

# Optional: Slack Incoming Webhook URL for the `notify` step.
# If unset, notifications are logged instead of sent (disclosed in README).
SLACK_WEBHOOK_URL=

# Base URL of this app's Hasura GraphQL endpoint, used by functions to call back into Hasura.
# Local: http://localhost:1337/v1/graphql (nhost local Hasura port, confirm via `nhost up` output)
HASURA_GRAPHQL_URL=http://localhost:1337/v1/graphql

# Admin secret for functions to call Hasura with elevated privileges (from .secrets locally).
HASURA_GRAPHQL_ADMIN_SECRET=
