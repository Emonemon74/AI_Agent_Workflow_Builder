# Secrets/config needed to run this project. There is no root .env that gets
# loaded automatically — nhost injects these into Functions via nhost.toml's
# [[global.environment]] blocks (see nhost/nhost.toml), which resolve
# `{{ secrets.KEY }}` placeholders against your local .secrets file (gitignored,
# created by `nhost init`) or, when deployed, against secrets set on the Cloud
# project (Dashboard -> Settings -> Secrets, or `nhost secrets create`).
#
# For local dev, add these lines to the project's .secrets file:

# Groq API key (https://console.groq.com/keys) — used by the llm_call step.
# If left empty, llm_call falls back to a stubbed response with an artificial
# delay (disclosed in the run output via output.stubbed = true).
GROQ_API_KEY=

# Slack Incoming Webhook URL, used by the `notify` step's Event Trigger handler.
# If left empty, notifications are logged via console.log instead of sent.
SLACK_WEBHOOK_URL=
