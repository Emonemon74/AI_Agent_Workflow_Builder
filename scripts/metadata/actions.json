{
  "type": "bulk",
  "args": [
    { "type": "set_custom_types", "args": {
      "scalars": [],
      "enums": [],
      "input_objects": [],
      "objects": [
        { "name": "TriggerWorkflowRunOutput", "fields": [
          { "name": "workflow_run_id", "type": "uuid!" },
          { "name": "status", "type": "String!" }
        ] },
        { "name": "TriggerWorkflowRunWebhookOutput", "fields": [
          { "name": "workflow_run_id", "type": "uuid!" },
          { "name": "status", "type": "String!" }
        ] },
        { "name": "ApproveStepOutput", "fields": [
          { "name": "step_run_id", "type": "uuid!" },
          { "name": "status", "type": "String!" },
          { "name": "workflow_run_status", "type": "String!" }
        ] }
      ]
    } },

    { "type": "create_action", "args": {
      "name": "triggerWorkflowRun",
      "comment": "Authenticated manual/internal trigger. Handler verifies owner/editor role and quota before starting a run.",
      "definition": {
        "kind": "synchronous",
        "type": "mutation",
        "arguments": [ { "name": "workflow_id", "type": "uuid!" } ],
        "output_type": "TriggerWorkflowRunOutput",
        "handler": "http://functions:3000/triggerWorkflowRun",
        "forward_client_headers": true,
        "timeout": 120
      }
    } },

    { "type": "create_action", "args": {
      "name": "triggerWorkflowRunWebhook",
      "comment": "Public inbound webhook endpoint. Handler validates a per-trigger secret instead of a user JWT.",
      "definition": {
        "kind": "synchronous",
        "type": "mutation",
        "arguments": [
          { "name": "workflow_id", "type": "uuid!" },
          { "name": "secret", "type": "String!" },
          { "name": "payload", "type": "json" }
        ],
        "output_type": "TriggerWorkflowRunWebhookOutput",
        "handler": "http://functions:3000/triggerWorkflowRunWebhook",
        "forward_client_headers": false,
        "timeout": 120
      }
    } },

    { "type": "create_action", "args": {
      "name": "approveStep",
      "comment": "Authenticated resume of a paused approval_gate step. Handler checks approver's org role before resuming.",
      "definition": {
        "kind": "synchronous",
        "type": "mutation",
        "arguments": [ { "name": "step_run_id", "type": "uuid!" } ],
        "output_type": "ApproveStepOutput",
        "handler": "http://functions:3000/approveStep",
        "forward_client_headers": true,
        "timeout": 120
      }
    } },

    { "type": "create_action_permission", "args": { "action": "triggerWorkflowRun", "role": "user" } },
    { "type": "create_action_permission", "args": { "action": "approveStep", "role": "user" } },
    { "type": "create_action_permission", "args": { "action": "triggerWorkflowRunWebhook", "role": "public" } }
  ]
}
